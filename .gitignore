# macOS / Xcode
.DS_Store
ios/*.xcodeproj
ios/*.xcworkspace
ios/**/xcuserdata/
ios/**/DerivedData/
ios/**/.build/
ios/**/.swiftpm/
*.xcarchive
*.ipa
*.dSYM.zip

# Python
__pycache__/
*.pyc
.venv/
pipeline/.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node (web viewer, later)
node_modules/
web/dist/

# VividHome data (raw sessions never go in git)
vividhome-data/
sessions/
*.f32
*.u8
!samples/**

# Secrets (never commit)
*.p8
AuthKey*.p8

# Claude Code local overrides (personal, per-clone)
.claude/settings.local.json

# Editors
.vscode/
.idea/

# The design canvas is assembled from docs/ui/canvas/ into a ~2.5 MB page that
# is mostly the editor payload. The artboards are the source; the built page is
# not, and is republished rather than stored.
vividhome-capture-app.html
